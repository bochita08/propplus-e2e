{
  "name": "propplus-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Tests E2E mobile (Appium + WebdriverIO) para la app PROP+",
  "scripts": {
    "local": "node scripts/run-local.mjs",
    "local:stop": "node scripts/run-local.mjs stop",
    "test": "wdio run wdio.conf.ts",
    "test:spec": "wdio run wdio.conf.ts --spec",
    "test:grep": "wdio run wdio.conf.ts --mochaOpts.grep",
    "test:smoke": "wdio run wdio.conf.ts --suite smoke",
    "report": "node scripts/allure.mjs generate allure-results --clean -o allure-report && node scripts/allure.mjs open allure-report",
    "report:generate": "node scripts/allure.mjs generate allure-results --clean -o allure-report",
    "report:open": "node scripts/allure.mjs open allure-report",
    "report:clean": "rimraf allure-results allure-report logs",
    "typecheck": "tsc --noEmit",
    "appium:doctor": "appium driver doctor uiautomator2",
    "appium:list": "appium driver list --installed"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.31.5",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.5.2",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "webdriverio": "^9.31.5"
  }
}
